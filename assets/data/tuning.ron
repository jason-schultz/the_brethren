[
    (
        id: "sight.range_km",
        group: "Sight",
        name: "How far a lookout sees",
        unit: "km",
        value: 8.0,
        min: 3.0,
        max: 20.0,
        historical: None,
        hints: (
            does: "Ships see each other this far off, day and night. Hunters find quarry, ships run from hunters, and word of what's seen spreads, all within it.",
            play: "Raise it and hunters find you sooner, and you can run sooner: more chases, fewer surprises. Lower it and the sea is emptier and more dangerous, and slipping past a raider is easier.",
            history: "From a masthead a topsail shows 15 to 20 km off in clear weather. The map is drawn at half scale, so 8 km here is about 16 km at sea: about what a lookout saw. Darkness, planned, will shorten it at night.",
        ),
    ),
    (
        id: "gunnery.timbers_per_hit",
        group: "Gunnery",
        name: "Hull damage per hit",
        unit: "share of timbers",
        value: 0.012,
        min: 0.002,
        max: 0.05,
        historical: None,
        hints: (
            does: "What one hit takes off a sloop's hull. Stouter ships lose less.",
            play: "Raise it and hulls give out before crews, so ships start leaking in a fight and battles end in sinkings and runs for port. Lower it and fights are decided by men, at boarding.",
            history: "Round shot rarely sank a wooden ship outright; it holed her, and the leaks did the rest. At today's value a sloop's crew is gone after 63 hits and her hull after 83.",
        ),
    ),
    (
        id: "gunnery.rigging_per_hit",
        group: "Gunnery",
        name: "Rigging damage per hit",
        unit: "share of rigging",
        value: 0.01,
        min: 0.002,
        max: 0.05,
        historical: None,
        hints: (
            does: "What one hit takes off a sloop's rigging. Torn rigging slows her.",
            play: "Raise it and fleeing ships are soon caught, and fights end sooner in a strike. Lower it and a merchant that runs gets away more often.",
            history: "The French favoured firing high at the rigging, the British low at the hull. Chain shot, planned with shot types, will aim at the rigging on purpose.",
        ),
    ),
    (
        id: "gunnery.men_per_hit",
        group: "Gunnery",
        name: "Men lost per hit",
        unit: "men",
        value: 0.35,
        min: 0.05,
        max: 1.5,
        historical: None,
        hints: (
            does: "Men killed or wounded by one hit, whatever the ship's size.",
            play: "Raise it and crews melt fast: captains strike sooner, and boarding comes earlier. Lower it and ships fight until their hulls give out, so more of them leak and sink.",
            history: "Splinters, not shot, did most of the killing. A sloop's crew went faster than her hull, as the game has it now.",
        ),
    ),
    (
