        min: 0.0,
        max: 0.8,
        historical: None,
        hints: (
            does: "A captain (not the player) strikes her colours when her hull falls below this.",
            play: "Raise it and captains give up while their ships are still sound: more prizes, fewer wrecks. Lower it and they fight on into leaking, and more go down.",
            history: "Merchant crews were paid by the voyage, not to fight, and most struck at the first broadside. Naval captains fought far longer.",
        ),
    ),
