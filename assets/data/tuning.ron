        min: 0.0,
        max: 0.8,
        historical: None,
        hints: (
            does: "A captain strikes when her rigging falls below this, and she can no longer run.",
            play: "Raise it and a crippled runner gives up sooner. Lower it and she fights on, dead in the water.",
