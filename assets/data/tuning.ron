        min: 0.1,
        max: 12.0,
        historical: None,
        hints: (
            does: "A quarry that slips out of sight and is seen again within this long is still the same chase, so the hunter's patience keeps running down.",
            play: "Raise it and slipping over the horizon and back doesn't fool a hunter. Lower it and a quarry at the edge of sight starts a fresh chase each time, which once let a chase last 26 days.",
